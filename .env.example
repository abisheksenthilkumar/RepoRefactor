# ============================================================
# RepoRefactor AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- REQUIRED ---
# Get your FREE key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# --- REQUIRED for PR Generation ---
# GitHub Personal Access Token (free)
# Scopes needed: repo (full control of private/public repos)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here

# --- OPTIONAL: GitHub username/org for the agent to commit as ---
GITHUB_USERNAME=your_github_username

# --- OPTIONAL: Gemini model (defaults to gemini-3.8-flash) ---
GEMINI_MODEL=gemini-3.8-flash

# --- OPTIONAL: Agent settings ---
MAX_SELF_CORRECTION_ITERATIONS=5
SANDBOX_TIMEOUT_SECONDS=30
MAX_REPO_FILES=200
MAX_CONTEXT_CHARS=800000

# --- OPTIONAL: Google Cloud (for production Cloud Run deployment) ---
# GCP_PROJECT_ID=your_gcp_project_id
# GCP_REGION=us-central1
